{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "SlopGuard",
          "version": "1.0.0",
          "informationUri": "https://github.com/joshhh62/slopguard",
          "rules": [
            {
              "id": "GAP001",
              "name": "Errorsilentlyswallowed",
              "shortDescription": {
                "text": "Error silently swallowed"
              },
              "fullDescription": {
                "text": "An exception/error is caught and discarded, hiding failures and corrupting state silently."
              },
              "help": {
                "text": "Handle the error, log it with context, or let it propagate. Catch the narrowest error type possible."
              },
              "properties": {
                "tags": [
                  "gap"
                ],
                "security-severity": "8.0"
              }
            },
            {
              "id": "GAP002",
              "name": "Bareexcept",
              "shortDescription": {
                "text": "Bare except"
              },
              "fullDescription": {
                "text": "`except:` also catches KeyboardInterrupt and SystemExit and masks programming errors."
              },
              "help": {
                "text": "Catch a specific exception class (or at minimum `except Exception:`) and handle it."
              },
              "properties": {
                "tags": [
                  "gap"
                ],
                "security-severity": "5.5"
              }
            },
            {
              "id": "GAP003",
              "name": "Mutabledefaultargument",
              "shortDescription": {
                "text": "Mutable default argument"
              },
              "fullDescription": {
                "text": "Default values are created once; a list/dict/set default is shared and mutated across calls."
              },
              "help": {
                "text": "Default to None and create the object inside the function."
              },
              "properties": {
                "tags": [
                  "gap"
                ],
                "security-severity": "5.5"
              }
            },
            {
              "id": "GAP004",
              "name": "Noautomatedtests",
              "shortDescription": {
                "text": "No automated tests"
              },
              "fullDescription": {
                "text": "The repository has source code but no test files, so regressions go unnoticed."
              },
              "help": {
                "text": "Add a test suite for the critical paths and run it in CI."
              },
              "properties": {
                "tags": [
                  "gap"
                ],
                "security-severity": "5.5"
              }
            },
            {
              "id": "GAP005",
              "name": "Missingprojecthygienefile",
              "shortDescription": {
                "text": "Missing project hygiene file"
              },
              "fullDescription": {
                "text": "Standard project files are missing (README, .gitignore, license, dependency manifest)."
              },
              "help": {
                "text": "Add the missing file so others can build, run and safely contribute to the project."
              },
              "properties": {
                "tags": [
                  "gap"
                ],
                "security-severity": "5.5"
              }
            },
            {
              "id": "GAP006",
              "name": "Networkcallwithouttimeout",
              "shortDescription": {
                "text": "Network call without timeout"
              },
              "fullDescription": {
                "text": "HTTP requests without a timeout can hang a worker forever when the remote end stalls."
              },
              "help": {
                "text": "Pass an explicit timeout (e.g. requests.get(url, timeout=10))."
              },
              "properties": {
                "tags": [
                  "gap"
                ],
                "security-severity": "5.5"
              }
            },
            {
              "id": "GAP007",
              "name": "Discardederrorreturn",
              "shortDescription": {
                "text": "Discarded error return"
              },
              "fullDescription": {
                "text": "The error result of a call is assigned to `_` and never checked."
              },
              "help": {
                "text": "Check the error and handle or wrap it (`if err != nil { return fmt.Errorf(...: %w, err) }`)."
              },
              "properties": {
                "tags": [
                  "gap"
                ],
                "security-severity": "5.5"
              }
            },
            {
              "id": "GAP009",
              "name": "Unpinneddependency",
              "shortDescription": {
                "text": "Unpinned dependency"
              },
              "fullDescription": {
                "text": "A requirement has no version constraint, so builds are not reproducible and can pull breaking or malicious releases."
              },
              "help": {
                "text": "Pin a version or compatible range (package>=1.2,<2) and commit a lock file."
              },
              "properties": {
                "tags": [
                  "gap"
                ],
                "security-severity": "3.0"
              }
            },
            {
              "id": "GAP011",
              "name": "Exceptionsilentlyswallowed",
              "shortDescription": {
                "text": "Exception silently swallowed"
              },
              "fullDescription": {
                "text": "An except block discards the error (only `pass`/`...`/`continue`), hiding real failures."
              },
              "help": {
                "text": "Log the exception with context, re-raise, or catch only the specific error you expect."
              },
              "properties": {
                "tags": [
                  "gap"
                ],
                "security-severity": "8.0"
              }
            },
            {
              "id": "LOOSE001",
              "name": "UnresolvedTODO/FIXME",
              "shortDescription": {
                "text": "Unresolved TODO/FIXME"
              },
              "fullDescription": {
                "text": "A work-in-progress marker was committed. FIXME/HACK/XXX/BUG usually mean known-broken code."
              },
              "help": {
                "text": "Resolve it, or move it into the issue tracker and link the ticket in the comment."
              },
              "properties": {
                "tags": [
                  "loose-end"
                ],
                "security-severity": "5.5"
              }
            },
            {
              "id": "LOOSE002",
              "name": "Commented-outcode",
              "shortDescription": {
                "text": "Commented-out code"
              },
              "fullDescription": {
                "text": "A block of code was disabled by commenting it out. Version control already remembers old code."
              },
              "help": {
                "text": "Delete the block; if it must come back, recover it from git history."
              },
              "properties": {
                "tags": [
                  "loose-end"
                ],
                "security-severity": "3.0"
              }
            },
            {
              "id": "LOOSE003",
              "name": "Stubbed-outimplementation",
              "shortDescription": {
                "text": "Stubbed-out implementation"
              },
              "fullDescription": {
                "text": "The function body only throws 'not implemented' - callers will crash at runtime."
              },
              "help": {
                "text": "Implement the behaviour, or remove the code path and its callers."
              },
              "properties": {
                "tags": [
                  "loose-end"
                ],
                "security-severity": "5.5"
              }
            },
            {
              "id": "LOOSE004",
              "name": "Unusedimport",
              "shortDescription": {
                "text": "Unused import"
              },
              "fullDescription": {
                "text": "An imported name is never used - dead weight left over from refactors or generation."
              },
              "help": {
                "text": "Remove the import."
              },
              "properties": {
                "tags": [
                  "loose-end"
                ],
                "security-severity": "3.0"
              }
            },
            {
              "id": "LOOSE005",
              "name": "Functionisneverreferenced",
              "shortDescription": {
                "text": "Function is never referenced"
              },
              "fullDescription": {
                "text": "A top-level function is defined but its name appears nowhere else in the repository."
              },
              "help": {
                "text": "Delete it if it is dead, or wire it up / export it if it was meant to be used."
              },
              "properties": {
                "tags": [
                  "loose-end"
                ],
                "security-severity": "3.0"
              }
            },
            {
              "id": "LOOSE006",
              "name": "Unreachablecode",
              "shortDescription": {
                "text": "Unreachable code"
              },
              "fullDescription": {
                "text": "Statements after return/raise/break/continue can never run."
              },
              "help": {
                "text": "Delete the dead statements or fix the control flow that was meant to reach them."
              },
              "properties": {
                "tags": [
                  "loose-end"
                ],
                "security-severity": "5.5"
              }
            },
            {
              "id": "LOOSE007",
              "name": "Emptyfunctionbody",
              "shortDescription": {
                "text": "Empty function body"
              },
              "fullDescription": {
                "text": "A function's body is only `pass`/`...` - it silently does nothing when called."
              },
              "help": {
                "text": "Implement it, raise NotImplementedError with a reason, or delete it."
              },
              "properties": {
                "tags": [
                  "loose-end"
                ],
                "security-severity": "5.5"
              }
            },
            {
              "id": "SEC001",
              "name": "Hard-codedprovidercredential",
              "shortDescription": {
                "text": "Hard-coded provider credential"
              },
              "fullDescription": {
                "text": "A credential with a vendor-specific format (AWS, GitHub, Stripe, ...) is committed to source."
              },
              "help": {
                "text": "Revoke and rotate the credential now, then load it from an environment variable or secret manager."
              },
              "properties": {
                "tags": [
                  "security"
                ],
                "security-severity": "9.5"
              }
            },
            {
              "id": "SEC002",
              "name": "Hard-codedsecretinassignment",
              "shortDescription": {
                "text": "Hard-coded secret in assignment"
              },
              "fullDescription": {
                "text": "A variable named like a password/token/key is assigned a literal, high-entropy value."
              },
              "help": {
                "text": "Move the value to an environment variable or secret store and rotate it if it was ever real."
              },
              "properties": {
                "tags": [
                  "security"
                ],
                "security-severity": "8.0"
              }
            },
            {
              "id": "SEC010",
              "name": "Dynamiccodeexecution",
              "shortDescription": {
                "text": "Dynamic code execution"
              },
              "fullDescription": {
                "text": "eval/exec-style call executes a string as code; attacker-influenced input becomes remote code execution."
              },
              "help": {
                "text": "Replace with a safe parser (json.loads, ast.literal_eval, a lookup table) or an explicit dispatch."
              },
              "properties": {
                "tags": [
                  "security"
                ],
                "security-severity": "8.0"
              }
            },
            {
              "id": "SEC011",
              "name": "Shellcommandbuiltatruntime",
              "shortDescription": {
                "text": "Shell command built at runtime"
              },
              "fullDescription": {
                "text": "A command is run through a shell; interpolated input enables command injection."
              },
              "help": {
                "text": "Pass an argument list without a shell (subprocess.run([...]), execFile, ProcessBuilder) and validate inputs."
              },
              "properties": {
                "tags": [
                  "security"
                ],
                "security-severity": "8.0"
              }
            },
            {
              "id": "SEC012",
              "name": "SQLbuiltwithstringinterpolation",
              "shortDescription": {
                "text": "SQL built with string interpolation"
              },
              "fullDescription": {
                "text": "A SQL statement is assembled by concatenation/formatting instead of bound parameters."
              },
              "help": {
                "text": "Use parameterised queries (cursor.execute(sql, params), prepared statements, or the ORM's query builder)."
              },
              "properties": {
                "tags": [
                  "security"
                ],
                "security-severity": "8.0"
              }
            },
            {
              "id": "SEC013",
              "name": "Unsafedeserialization",
              "shortDescription": {
                "text": "Unsafe deserialization"
              },
              "fullDescription": {
                "text": "Deserializing untrusted data with this API can execute arbitrary code."
              },
              "help": {
                "text": "Use a data-only format (JSON) or a safe loader (yaml.safe_load); never unpickle untrusted bytes."
              },
              "properties": {
                "tags": [
                  "security"
                ],
                "security-severity": "8.0"
              }
            },
            {
              "id": "SEC014",
              "name": "Weakcryptographicprimitive",
              "shortDescription": {
                "text": "Weak cryptographic primitive"
              },
              "fullDescription": {
                "text": "MD5/SHA-1/DES/ECB are broken for security purposes (passwords, signatures, tokens)."
              },
              "help": {
                "text": "Use SHA-256+ for integrity, bcrypt/argon2/scrypt for passwords, and AES-GCM for encryption."
              },
              "properties": {
                "tags": [
                  "security"
                ],
                "security-severity": "5.5"
              }
            },
            {
              "id": "SEC015",
              "name": "TLScertificateverificationdisabled",
              "shortDescription": {
                "text": "TLS certificate verification disabled"
              },
              "fullDescription": {
                "text": "Disabling certificate checks allows trivial man-in-the-middle attacks."
              },
              "help": {
                "text": "Remove the override; if a private CA is needed, configure its bundle explicitly."
              },
              "properties": {
                "tags": [
                  "security"
                ],
                "security-severity": "8.0"
              }
            },
            {
              "id": "SEC016",
              "name": "Predictablerandomnessforasecurityvalue",
              "shortDescription": {
                "text": "Predictable randomness for a security value"
              },
              "fullDescription": {
                "text": "A non-cryptographic RNG generates something that looks like a token, password, OTP or key."
              },
              "help": {
                "text": "Use a CSPRNG: secrets.token_urlsafe(), crypto.randomBytes()/crypto.randomUUID(), SecureRandom."
              },
              "properties": {
                "tags": [
                  "security"
                ],
                "security-severity": "5.5"
              }
            },
            {
              "id": "SEC017",
              "name": "UnescapedHTMLsink",
              "shortDescription": {
                "text": "Unescaped HTML sink"
              },
              "fullDescription": {
                "text": "Raw HTML is injected into the page; untrusted data here is cross-site scripting."
              },
              "help": {
                "text": "Render text with textContent / framework escaping, or sanitise with a vetted library (DOMPurify)."
              },
              "properties": {
                "tags": [
                  "security"
                ],
                "security-severity": "5.5"
              }
            },
            {
              "id": "SEC018",
              "name": "Debugmodeenabled",
              "shortDescription": {
                "text": "Debug mode enabled"
              },
              "fullDescription": {
                "text": "Debug mode exposes stack traces, interactive debuggers or secrets in production."
              },
              "help": {
                "text": "Drive debug flags from the environment and default them to off."
              },
              "properties": {
                "tags": [
                  "security"
                ],
                "security-severity": "5.5"
              }
            },
            {
              "id": "SEC020",
              "name": "Plain-HTTPendpoint",
              "shortDescription": {
                "text": "Plain-HTTP endpoint"
              },
              "fullDescription": {
                "text": "Traffic to this endpoint is unencrypted and can be read or modified in transit."
              },
              "help": {
                "text": "Use https:// (or make the scheme configurable for local development)."
              },
              "properties": {
                "tags": [
                  "security"
                ],
                "security-severity": "3.0"
              }
            },
            {
              "id": "SEC021",
              "name": "Secretsfilecommitted",
              "shortDescription": {
                "text": "Secrets file committed"
              },
              "fullDescription": {
                "text": "Environment or key files are part of the repository."
              },
              "help": {
                "text": "Delete the file from version control (and history), rotate its secrets, and add it to .gitignore."
              },
              "properties": {
                "tags": [
                  "security"
                ],
                "security-severity": "8.0"
              }
            },
            {
              "id": "SEC022",
              "name": "Prompt-injectionpayloadaimedatAIagents",
              "shortDescription": {
                "text": "Prompt-injection payload aimed at AI agents"
              },
              "fullDescription": {
                "text": "Text addressed to an AI assistant tries to override its instructions. Coding agents and AI reviewers that read this repo may obey it."
              },
              "help": {
                "text": "Remove the text and audit who added it; never let repository content steer automation."
              },
              "properties": {
                "tags": [
                  "security"
                ],
                "security-severity": "8.0"
              }
            },
            {
              "id": "SLOP001",
              "name": "LLMchatresidueincode",
              "shortDescription": {
                "text": "LLM chat residue in code"
              },
              "fullDescription": {
                "text": "Conversational assistant text or a markdown fence was pasted into a source file."
              },
              "help": {
                "text": "Delete the conversational text and review the surrounding code - it was likely never read by a human."
              },
              "properties": {
                "tags": [
                  "slop"
                ],
                "security-severity": "8.0"
              }
            },
            {
              "id": "SLOP002",
              "name": "Elidedorplaceholderimplementation",
              "shortDescription": {
                "text": "Elided or placeholder implementation"
              },
              "fullDescription": {
                "text": "Generated code was truncated (an elided 'rest of the code' marker or a 'your logic here' stub), so behaviour is missing."
              },
              "help": {
                "text": "Write the missing implementation, or delete the stub and fail loudly until it exists."
              },
              "properties": {
                "tags": [
                  "slop"
                ],
                "security-severity": "8.0"
              }
            },
            {
              "id": "SLOP003",
              "name": "Placeholdervalueleftincode",
              "shortDescription": {
                "text": "Placeholder value left in code"
              },
              "fullDescription": {
                "text": "A template value (an API-key placeholder, 'change me', lorem ipsum) was never replaced."
              },
              "help": {
                "text": "Read the value from configuration and fail fast with a clear error when it is missing."
              },
              "properties": {
                "tags": [
                  "slop"
                ],
                "security-severity": "5.5"
              }
            },
            {
              "id": "SLOP004",
              "name": "Undeclared(possiblyhallucinated)dependency",
              "shortDescription": {
                "text": "Undeclared (possibly hallucinated) dependency"
              },
              "fullDescription": {
                "text": "Code imports a package that no manifest declares. AI tools often invent package names that attackers then register (slopsquatting)."
              },
              "help": {
                "text": "Verify the package really exists and is the one you intend, then declare and pin it - or remove the import."
              },
              "properties": {
                "tags": [
                  "slop"
                ],
                "security-severity": "8.0"
              }
            },
            {
              "id": "SLOP005",
              "name": "Duplicatedcodeblock",
              "shortDescription": {
                "text": "Duplicated code block"
              },
              "fullDescription": {
                "text": "The same block of logic appears in more than one place; fixes applied to one copy will miss the others."
              },
              "help": {
                "text": "Extract the shared logic into one function/module and call it from both places."
              },
              "properties": {
                "tags": [
                  "slop"
                ],
                "security-severity": "5.5"
              }
            },
            {
              "id": "SLOP006",
              "name": "Commentnarratesobviouscode",
              "shortDescription": {
                "text": "Comment narrates obvious code"
              },
              "fullDescription": {
                "text": "Boilerplate comments like '# Initialize variables' or '// Return the result' add noise, not intent."
              },
              "help": {
                "text": "Delete the comment, or replace it with the *why* behind the code."
              },
              "properties": {
                "tags": [
                  "slop"
                ],
                "security-severity": "3.0"
              }
            },
            {
              "id": "SLOP007",
              "name": "Debuggingleftover",
              "shortDescription": {
                "text": "Debugging leftover"
              },
              "fullDescription": {
                "text": "A debugger hook or ad-hoc debug print was left in committed code."
              },
              "help": {
                "text": "Remove it, or route the message through the project's logger at debug level."
              },
              "properties": {
                "tags": [
                  "slop"
                ],
                "security-severity": "3.0"
              }
            }
          ]
        }
      },
      "results": [
        {
